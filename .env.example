CITYJSON_WORK_DIR=/path/to/project/workdir

AIRFLOW__CORE__LOAD_EXAMPLES=False

DOCKER_HOST=unix:///var/run/docker.sock

CITYJSON_THREAD_COUNT=4
CITYJSON_SIMPLIFY_ADDRESSES=false
CITYJSON_SHOW_STACK_TRACE=false

# DGM1 terrain pipeline
# DGM1_META4_PATH defaults to dgm1.meta4 inside the DAG bundle (dags/).
DGM1_DOWNLOAD_WORKERS=4
DGM1_CTB_THREADS=4
DGM1_UPLOAD_WORKERS=8

# Project-specific Airflow connection shared by both DAGs (JSON must remain on one line)
AIRFLOW_CONN_DET_RG_S3='{"conn_type":"aws","login":"your-access-key","password":"your-secret-key","extra":{"endpoint_url":"https://your-s3-host","region_name":"eu-central-1","config_kwargs":{"s3":{"addressing_style":"path"}}}}'

# S3 GUI — endpoint must be reachable from inside Docker
# For external server: use the same endpoint and credentials as the DAG connections
# For localstack: http://localstack:4566
S3_GUI_ENDPOINT=https://your-s3-host
S3_GUI_REGION=eu-central-1
S3_GUI_ACCESS_KEY_ID=your-access-key
S3_GUI_SECRET_ACCESS_KEY=your-secret-key
S3_BUCKET_NAMES=det-rg-upload,det-rg-gml,det-rg-json,det-rg-main,det-rg-terrain
S3_GUI_PORT=3000

# Only needed when running with --profile local
LOCALSTACK_DEBUG=0
LOCALSTACK_S3_REGION=eu-central-1
LOCALSTACK_S3_ACCESS_KEY_ID=test
LOCALSTACK_S3_SECRET_ACCESS_KEY=test
